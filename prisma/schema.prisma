// Aetheria AI — Prisma schema
// Source of truth: "Bible of Aetheria AI" (database structure section)
// Adapted to Prisma 7 generator format (prisma-client + output path).
// Connection URL is loaded from prisma7.config.ts via DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     String  @id @default(cuid())
  email  String  @unique
  name   String
  orders Order[]
  leads  Lead[]
}

model Product {
  id          String  @id @default(cuid())
  title       String
  price       Decimal
  description String
  demoUrl     String
  imageUrl    String
  orders      Order[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  productId String
  status    OrderStatus @default(PENDING)
  user      User        @relation(fields: [userId], references: [id])
  product   Product     @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
}

// Leads from the contact form / quote requests
model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  budget    String?
  source    String?    @default("contact_form")
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  LOST
}
